---
import { getAgreementsWithLatestEvent } from "db";
import { templateIds } from "../../agreements";

const agreementsList = await getAgreementsWithLatestEvent({ limit: 20, offset: 0 });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Agreements</title>
		<style>
			:root {
				--border: #e2e2e7;
				--text: #1c1c1f;
				--muted: #6b6b76;
				--accent: #2563eb;
				--danger: #dc2626;
				--bg-subtle: #f7f7f9;
			}

			body {
				max-width: 720px;
				margin: 3rem auto;
				padding: 0 1.5rem;
				font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
				color: var(--text);
			}

			h1 {
				font-size: 1.5rem;
				margin-bottom: 1.5rem;
			}

			#createAgreementForm {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.75rem 1rem;
				padding: 1.25rem;
				margin-bottom: 2rem;
				background: var(--bg-subtle);
				border: 1px solid var(--border);
				border-radius: 8px;
			}

			#createAgreementForm label {
				font-size: 0.8rem;
				color: var(--muted);
				margin-bottom: 0.25rem;
				display: block;
			}

			#createAgreementForm input,
			#createAgreementForm select {
				width: 100%;
				padding: 0.5rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				font-size: 0.9rem;
			}

			#createAgreementForm button {
				grid-column: 1 / -1;
				justify-self: start;
				padding: 0.5rem 1.25rem;
				background: var(--accent);
				color: white;
				border: none;
				border-radius: 6px;
				font-size: 0.9rem;
				cursor: pointer;
			}

			#createAgreementForm button:hover {
				opacity: 0.9;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.9rem;
			}

			th,
			td {
				text-align: left;
				padding: 0.6rem 0.5rem;
				border-bottom: 1px solid var(--border);
			}

			th {
				color: var(--muted);
				font-weight: 600;
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}

			tbody tr:hover {
				background: var(--bg-subtle);
			}

			.deleteButton {
				padding: 0.3rem 0.75rem;
				background: transparent;
				border: 1px solid var(--danger);
				color: var(--danger);
				border-radius: 6px;
				font-size: 0.8rem;
				cursor: pointer;
			}

			.deleteButton:hover {
				background: var(--danger);
				color: white;
			}
		</style>
	</head>
	<body>
		<h1>Agreements</h1>

		<form id="createAgreementForm">
			<label for="templateId">Template</label>
			<select id="templateId" name="templateId">
				{templateIds.map((templateId) => <option value={templateId}>{templateId}</option>)}
			</select>

			<label for="firstName">First Name</label>
			<input id="firstName" name="firstName" type="text" required />

			<label for="lastName">Last Name</label>
			<input id="lastName" name="lastName" type="text" required />

			<label for="email">Email</label>
			<input id="email" name="email" type="email" required />

			<label for="phoneNumber">Phone</label>
			<input id="phoneNumber" name="phoneNumber" type="text" required />

			<button type="submit">Create</button>
		</form>

		<table>
			<thead>
				<tr>
					<th>First Name</th>
					<th>Last Name</th>
					<th>Email</th>
					<th>Phone</th>
					<th>Template</th>
					<th>Status</th>
					<th>Created At</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{
					agreementsList.map((agreement) => (
						<tr>
							<td>{agreement.firstName}</td>
							<td>{agreement.lastName}</td>
							<td>{agreement.email}</td>
							<td>{agreement.phoneNumber}</td>
							<td>{agreement.templateId}</td>
							<td>{agreement.events[0]?.eventType ?? "—"}</td>
							<td>{new Date(agreement.createdAt).toLocaleString("en-US")}</td>
							<td>
								<button class="deleteButton" data-id={agreement.id}>Delete</button>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>

		<script>
			import { actions } from "astro:actions";

			const form = document.getElementById("createAgreementForm") as HTMLFormElement;

			form.addEventListener("submit", async (event) => {
				event.preventDefault();

				const templateId = (document.getElementById("templateId") as HTMLSelectElement).value;
				const firstName = (document.getElementById("firstName") as HTMLInputElement).value;
				const lastName = (document.getElementById("lastName") as HTMLInputElement).value;
				const email = (document.getElementById("email") as HTMLInputElement).value;
				const phoneNumber = (document.getElementById("phoneNumber") as HTMLInputElement).value;

				const { error } = await actions.initiateAgreement({
					templateId,
					props: { firstName, lastName, phoneNumber, email },
				});

				if (error) {
					alert(error.message);
				} else {
					location.reload();
				}
			});

			const deleteButtons = document.querySelectorAll<HTMLButtonElement>(".deleteButton");

			deleteButtons.forEach((button) => {
				button.addEventListener("click", async () => {
					const id = button.dataset.id;

					const confirmed = confirm("Are you sure you want to delete this agreement?");
					if (!confirmed) {
						return;
					}

					const { error } = await actions.removeAgreement({ id });

					if (error) {
						alert(error.message);
					} else {
						location.reload();
					}
				});
			});
		</script>
	</body>
</html>
