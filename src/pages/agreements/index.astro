---
import { getAgreementsWithLatestEvent } from "db";
import { agreementEventTypeSchema } from "types";
import { templateIds } from "../../agreements";
import Header from "../../components/Header.astro";

const searchParams = Astro.url.searchParams;

const parsedStatus = agreementEventTypeSchema.safeParse(searchParams.get("status"));
const activeStatus = parsedStatus.success ? parsedStatus.data : undefined;

const firstNameFilter = searchParams.get("firstName") ?? "";
const lastNameFilter = searchParams.get("lastName") ?? "";
const emailFilter = searchParams.get("email") ?? "";
const phoneFilter = searchParams.get("phone") ?? "";
const sortParam = searchParams.get("sort") === "oldest" ? "oldest" : "newest";

const PAGE_SIZE = 50;
const currentPage = Math.max(1, Number(searchParams.get("page")) || 1);

const { items: agreementsList, total: totalCount } = await getAgreementsWithLatestEvent({
  limit: PAGE_SIZE,
  offset: (currentPage - 1) * PAGE_SIZE,
  status: activeStatus,
  firstName: firstNameFilter || undefined,
  lastName: lastNameFilter || undefined,
  email: emailFilter || undefined,
  phoneNumber: phoneFilter || undefined,
  sort: sortParam,
});

const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

function buildPageUrl(page: number) {
  const params = new URLSearchParams(searchParams);
  params.set("page", String(page));
  return `/agreements?${params.toString()}`;
}

const statusMeta = {
  created: { label: "Created", bg: "#f1f1f0", text: "#5f5e5a" },
  sent: { label: "Sent", bg: "#e6f1fb", text: "#0c447c" },
  viewed: { label: "Viewed", bg: "#faeeda", text: "#854f0b" },
  signed: { label: "Signed", bg: "#eaf3de", text: "#27500a" },
  rejected: { label: "Rejected", bg: "#fcebeb", text: "#791f1f" },
};

const hasActiveFilters = Boolean(
  activeStatus || firstNameFilter || lastNameFilter || emailFilter || phoneFilter || sortParam === "oldest",
);

function formatDate(date: Date) {
  const d = String(date.getDate()).padStart(2, "0");
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const y = date.getFullYear();
  const hh = String(date.getHours()).padStart(2, "0");
  const mm = String(date.getMinutes()).padStart(2, "0");
  return `${d}/${m}/${y} ${hh}:${mm}`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Agreements</title>
    <style>
      :root {
        --border: #e2e2e7;
        --text: #1c1c1f;
        --muted: #6b6b76;
        --accent: #2563eb;
        --danger: #dc2626;
        --page-bg: #f5f5f7;
        --panel-bg: #ffffff;
      }
      body {
        margin: 0;
        background: var(--page-bg);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        color: var(--text);
      }
      .page {
        padding: 2rem 2.5rem 4rem;
      }
      .pageTitle {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0 0 0.35rem;
      }
      .pageSubtitle {
        font-size: 0.9rem;
        color: var(--muted);
        margin: 0 0 2rem;
      }
      .layout {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 2rem;
        align-items: start;
      }

      /* --- Create panel --- */
      .createPanel {
        background: var(--panel-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        position: sticky;
        top: 2rem;
      }
      .createPanelEyebrow {
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 0.4rem;
      }
      .createPanelTitle {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0 0 1.25rem;
      }
      .createPanel label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--muted);
        margin: 1rem 0 0.3rem;
      }
      .createPanel label:first-of-type {
        margin-top: 0;
      }
      .createPanel input,
      .createPanel select {
        width: 100%;
        box-sizing: border-box;
        padding: 0.55rem 0.65rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 0.9rem;
        font-family: inherit;
      }
      .createPanel button {
        width: 100%;
        margin-top: 1.5rem;
        padding: 0.65rem;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
      }
      .createPanel button:hover {
        opacity: 0.9;
      }

      /* --- List area --- */
      .listArea {
        min-width: 0;
      }
      .listAreaHeader {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 1rem;
      }
      .listAreaTitle {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
      }
      .listAreaMeta {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      }
      .listAreaCount {
        font-size: 0.85rem;
        color: var(--muted);
      }
      .clearFiltersLink {
        font-size: 0.85rem;
        color: var(--accent);
      }

      .filterBar {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr)) 140px 140px 100px;
        gap: 0.75rem;
        align-items: end;
        background: var(--panel-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1.25rem;
      }
      .filterField {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .filterField label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .filterField input,
      .filterField select {
        padding: 0.5rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 0.85rem;
        font-family: inherit;
        box-sizing: border-box;
      }
      .filterBar button {
        padding: 0.5rem 1rem;
        border-radius: 7px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: white;
      }

      .tableWrap {
        background: var(--panel-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.87rem;
      }
      thead th {
        text-align: left;
        padding: 0.85rem 1rem;
        background: #fafafb;
        border-bottom: 1px solid var(--border);
        color: var(--muted);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }
      tbody td {
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        white-space: nowrap;
      }
      tbody tr:last-child td {
        border-bottom: none;
      }
      tbody tr {
        cursor: pointer;
      }
      tbody tr:hover {
        background: #fafafb;
      }
      .nameCell {
        font-weight: 600;
      }
      .dateCell {
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .statusPill {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: inherit;
      }
      a.statusPill {
        cursor: pointer;
      }
      .rowActions button {
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        font-size: 0.78rem;
        cursor: pointer;
        border: 1px solid var(--danger);
        background: var(--danger);
        color: white;
      }
      .emptyState {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 1.25rem 0 0;
      }
      .paginationButton {
        padding: 0.4rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 0.85rem;
        text-decoration: none;
        color: var(--text);
        background: var(--panel-bg);
      }
      .paginationButton:hover {
        background: #fafafb;
      }
      .paginationButton.disabled {
        pointer-events: none;
        opacity: 0.4;
      }
      .paginationInfo {
        font-size: 0.85rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <Header showSignOut={true} />

    <div class="page">
      <h1 class="pageTitle">Agreements</h1>
      <p class="pageSubtitle">Create new agreements and manage existing ones.</p>

      <div class="layout">
        <aside class="createPanel">
          <p class="createPanelEyebrow">New</p>
          <h2 class="createPanelTitle">Create Agreement</h2>

          <form id="createAgreementForm">
            <label for="templateId">Template</label>
            <select id="templateId" name="templateId">
              {templateIds.map((templateId) => <option value={templateId}>{templateId}</option>)}
            </select>

            <label for="firstName">First Name</label>
            <input id="firstName" name="firstName" type="text" placeholder="First name" required />

            <label for="lastName">Last Name</label>
            <input id="lastName" name="lastName" type="text" placeholder="Last name" required />

            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="name@example.com" required />

            <label for="phoneNumber">Phone</label>
            <input id="phoneNumber" name="phoneNumber" type="text" placeholder="0 (5XX) XXX XX XX" required />

            <button type="submit">Create Agreement</button>
          </form>
        </aside>

        <main class="listArea">
          <div class="listAreaHeader">
            <h2 class="listAreaTitle">All Agreements</h2>
            <div class="listAreaMeta">
              <span class="listAreaCount">{totalCount} results</span>
              {hasActiveFilters && (
                <a href="/agreements" class="clearFiltersLink">Clear filters</a>
              )}
            </div>
          </div>

          <form class="filterBar" method="GET" action="/agreements">
            <div class="filterField">
              <label for="filterFirstName">First Name</label>
              <input id="filterFirstName" name="firstName" type="text" placeholder="Search first name" value={firstNameFilter} />
            </div>
            <div class="filterField">
              <label for="filterLastName">Last Name</label>
              <input id="filterLastName" name="lastName" type="text" placeholder="Search last name" value={lastNameFilter} />
            </div>
            <div class="filterField">
              <label for="filterEmail">Email</label>
              <input id="filterEmail" name="email" type="text" placeholder="Search email" value={emailFilter} />
            </div>
            <div class="filterField">
              <label for="filterPhone">Phone</label>
              <input id="filterPhone" name="phone" type="text" placeholder="Search phone" value={phoneFilter} />
            </div>
            <div class="filterField">
              <label for="filterStatus">Status</label>
              <select id="filterStatus" name="status">
                <option value="">All</option>
                {Object.entries(statusMeta).map(([type, meta]) => (
                  <option value={type} selected={activeStatus === type}>{meta.label}</option>
                ))}
              </select>
            </div>
            <div class="filterField">
              <label for="filterSort">Sort by date</label>
              <select id="filterSort" name="sort">
                <option value="newest" selected={sortParam === "newest"}>Newest first</option>
                <option value="oldest" selected={sortParam === "oldest"}>Oldest first</option>
              </select>
            </div>
            <button type="submit">Apply</button>
          </form>

          <div class="tableWrap">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>First Name</th>
                  <th>Last Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {agreementsList.length === 0 ? (
                  <tr>
                    <td class="emptyState" colspan="8">No agreements match these filters.</td>
                  </tr>
                ) : (
                  agreementsList.map((agreement) => {
                    const eventType = agreement.events[0].eventType;
                    const status = statusMeta[eventType as keyof typeof statusMeta];
                    return (
                      <tr data-id={agreement.id}>
                        <td class="dateCell">{formatDate(new Date(agreement.createdAt))}</td>
                        <td class="nameCell">{agreement.firstName}</td>
                        <td class="nameCell">{agreement.lastName}</td>
                        <td>{agreement.email}</td>
                        <td>{agreement.phoneNumber}</td>
                        <td>{agreement.templateId}</td>
                        <td>
                          {eventType === "signed" ? (
                            <a
                              href="#"
                              class="statusPill signedLink"
                              data-id={agreement.id}
                              style={`background: ${status.bg}; color: ${status.text};`}
                            >
                              {status.label}
                            </a>
                          ) : (
                            <span class="statusPill" style={`background: ${status.bg}; color: ${status.text};`}>
                              {status.label}
                            </span>
                          )}
                        </td>
                        <td class="rowActions">
                          {eventType === "created" && (
                            <button type="button" class="sendButton" data-id={agreement.id}>Send</button>
                          )}
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>

          {totalPages > 1 && (
            <div class="pagination">
              <a
                href={currentPage > 1 ? buildPageUrl(currentPage - 1) : "#"}
                class={`paginationButton${currentPage <= 1 ? " disabled" : ""}`}
              >
                &larr; Previous
              </a>
              <span class="paginationInfo">Page {currentPage} of {totalPages}</span>
              <a
                href={currentPage < totalPages ? buildPageUrl(currentPage + 1) : "#"}
                class={`paginationButton${currentPage >= totalPages ? " disabled" : ""}`}
              >
                Next &rarr;
              </a>
            </div>
          )}
        </main>
      </div>
    </div>

    <script>
      import { actions } from "astro:actions";

      const form = document.getElementById("createAgreementForm") as HTMLFormElement;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const templateId = (document.getElementById("templateId") as HTMLSelectElement).value;
        const firstName = (document.getElementById("firstName") as HTMLInputElement).value;
        const lastName = (document.getElementById("lastName") as HTMLInputElement).value;
        const email = (document.getElementById("email") as HTMLInputElement).value;
        const phoneNumber = (document.getElementById("phoneNumber") as HTMLInputElement).value;

        const { error } = await actions.initiateAgreement({
          templateId,
          props: { firstName, lastName, phoneNumber, email },
        });

        if (error) {
          alert(error.message);
        } else {
          location.reload();
        }
      });

      const agreementRows = document.querySelectorAll<HTMLElement>("tbody tr[data-id]");

      agreementRows.forEach((row) => {
        row.addEventListener("click", () => {
          location.href = `/agreements/${row.dataset.id}`;
        });
      });

      const sendButtons = document.querySelectorAll<HTMLButtonElement>(".sendButton");

      sendButtons.forEach((button) => {
        button.addEventListener("click", async (event) => {
          event.stopPropagation();
          const id = button.dataset.id;

          const confirmed = confirm("Are you sure you want to send this agreement?");
          if (!confirmed) {
            return;
          }

          const { error } = await actions.sendUnsignedAgreement({ id });

          if (error) {
            alert(error.message);
          } else {
            location.reload();
          }
        });
      });

      const signedLinks = document.querySelectorAll<HTMLAnchorElement>(".signedLink");

      signedLinks.forEach((link) => {
        link.addEventListener("click", async (event) => {
          event.preventDefault();
          event.stopPropagation();
          const id = link.dataset.id;

          const { data: pdfBytes, error } = await actions.getSignedAgreementPdf({ id });

          if (error) {
            alert(error.message);
            return;
          }

          const blob = new Blob([pdfBytes], { type: "application/pdf" });
          window.open(URL.createObjectURL(blob), "_blank");
        });
      });
    </script>
  </body>
</html>
